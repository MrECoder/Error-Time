<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP dependency-check suppressions for this project.

  Add an entry here only for a finding that has been reviewed and is either
  a confirmed false positive or an accepted/mitigated risk - never to silence
  something unreviewed. Every entry must have a dated <notes> comment
  explaining why, so a future reviewer (or a re-run months later) can tell
  whether the suppression still applies.

  Schema/how-to: https://jeremylong.github.io/DependencyCheck/general/suppression.html

  Example:
  <suppress>
     <notes><![CDATA[
        2026-09-17: CVE-2024-XXXXX only affects the XML parser codepath,
        which this project never invokes (see AppException javadoc for why
        XML processing isn't part of this library's surface). Re-check if
        that ever changes.
     ]]></notes>
     <packageUrl regex="true">^pkg:maven/some\.group/some-artifact@.*$</packageUrl>
     <cve>CVE-2024-XXXXX</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
