<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mrecoder</groupId>
  <artifactId>error-time-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Error-Time Parent</name>
  <description>Centralized error handling, error-code taxonomy, metrics and trace propagation for Spring Boot microservices</description>

  <modules>
    <module>error-time-spring-boot-starter</module>
    <module>error-time-example-service</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <spring-boot.version>4.1.1</spring-boot.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>

    <!-- Placeholders - set the real Nexus URLs before the first `mvn deploy`,
         either here or with -Dnexus.releases.url=... -Dnexus.snapshots.url=...
         Credentials go only in ~/.m2/settings.xml <servers>, keyed by the
         <id>s below - never in this file. -->
    <nexus.releases.url>https://REPLACE-ME/repository/maven-releases/</nexus.releases.url>
    <nexus.snapshots.url>https://REPLACE-ME/repository/maven-snapshots/</nexus.snapshots.url>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <!-- spring-boot-starter-parent sets this by default; without it,
                 Spring's @Bean-method parameter-name-based disambiguation
                 (e.g. two Queue beans resolved by matching a parameter name
                 to a bean name) silently breaks since javac drops formal
                 parameter names unless told to keep them. -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <distributionManagement>
    <repository>
      <id>nexus-releases</id>
      <url>${nexus.releases.url}</url>
    </repository>
    <snapshotRepository>
      <id>nexus-snapshots</id>
      <url>${nexus.snapshots.url}</url>
    </snapshotRepository>
  </distributionManagement>

</project>
