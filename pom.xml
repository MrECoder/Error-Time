<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mrecoder</groupId>
  <artifactId>error-time-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Error-Time Parent</name>
  <description>Centralized error handling, error-code taxonomy, metrics and trace propagation for Spring Boot microservices</description>

  <modules>
    <module>error-time-spring-boot-starter</module>
    <module>error-time-example-service</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <spring-boot.version>4.1.1</spring-boot.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <resilience4j.version>2.3.0</resilience4j.version>

    <!-- Placeholders - set the real Nexus URLs before the first `mvn deploy`,
         either here or with -Dnexus.releases.url=... -Dnexus.snapshots.url=...
         Credentials go only in ~/.m2/settings.xml <servers>, keyed by the
         <id>s below - never in this file. -->
    <nexus.releases.url>https://REPLACE-ME/repository/maven-releases/</nexus.releases.url>
    <nexus.snapshots.url>https://REPLACE-ME/repository/maven-snapshots/</nexus.snapshots.url>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <!-- spring-boot-starter-parent sets this by default; without it,
                 Spring's @Bean-method parameter-name-based disambiguation
                 (e.g. two Queue beans resolved by matching a parameter name
                 to a bean name) silently breaks since javac drops formal
                 parameter names unless told to keep them. -->
            <parameters>true</parameters>
            <!-- On this javac, annotation processors are only discovered from
                 -processorpath, never from the plain compile classpath - without
                 an explicit annotationProcessorPaths list, @Slf4j (and any other
                 Lombok annotation) compiles with no error but silently generates
                 nothing. Let entries below resolve their version from
                 dependencyManagement (spring-boot-dependencies) instead of
                 duplicating it here. -->
            <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>2.9.3</version>
        </plugin>
        <!-- Not bound to any phase - deliberately requires network access to the
             NVD/OSS Index, which a normal `mvn verify` shouldn't depend on.
             Run explicitly: mvn org.owasp:dependency-check-maven:aggregate
             (aggregate, not check, so a reactor build produces one combined
             report instead of a separate one per module). CI runs this on
             every push/PR - see .github/workflows/ci.yml's "cve-scan" job -
             and REQUIRES -DnvdApiKey=... : as of the NVD API 2.0 client this
             plugin version bundles, an unauthenticated request is rejected
             outright rather than merely rate-limited (confirmed empirically -
             this is not just older advice going stale). Request a free key at
             https://nvd.nist.gov/developers/request-an-api-key. -->
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>13.0.0</version>
          <configuration>
            <!-- Fails the build only on High/Critical (CVSS v3 >= 7) so the
                 gate flags real risk without drowning in every Low/Medium
                 finding across the dependency tree; adjust per the project's
                 own risk tolerance. -->
            <failBuildOnCVSS>7</failBuildOnCVSS>
            <formats>
              <format>HTML</format>
              <format>SARIF</format>
            </formats>
            <!-- Empty by default - add an entry here (with a dated comment
                 explaining why) only for a confirmed false positive or an
                 accepted/mitigated risk, never to silence an unreviewed
                 finding. -->
            <suppressionFiles>
              <suppressionFile>${maven.multiModuleProjectDirectory}/owasp-suppressions.xml</suppressionFile>
            </suppressionFiles>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.13</version>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
              <configuration>
                <excludes>
                  <!-- SpringApplication.run(...) boilerplate - nothing to unit-test,
                       and covering it would mean starting a full application context
                       just to satisfy a coverage percentage. -->
                  <exclude>**/*Application.class</exclude>
                </excludes>
              </configuration>
            </execution>
            <execution>
              <!-- Bound to verify (not test) so `mvn test` stays fast for local
                   iteration; `mvn verify`/CI is where the 85% floor is enforced. -->
              <id>jacoco-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <excludes>
                  <exclude>**/*Application.class</exclude>
                </excludes>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>INSTRUCTION</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.85</minimum>
                      </limit>
                      <limit>
                        <counter>BRANCH</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.85</minimum>
                      </limit>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.85</minimum>
                      </limit>
                      <limit>
                        <counter>COMPLEXITY</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.85</minimum>
                      </limit>
                      <limit>
                        <counter>METHOD</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.85</minimum>
                      </limit>
                      <limit>
                        <counter>CLASS</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.85</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>nexus-releases</id>
      <url>${nexus.releases.url}</url>
    </repository>
    <snapshotRepository>
      <id>nexus-snapshots</id>
      <url>${nexus.snapshots.url}</url>
    </snapshotRepository>
  </distributionManagement>

</project>
